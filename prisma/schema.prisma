generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══ Quick Actions: branches, teams, access, contacts ═══════════════════════

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  gstin     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  teams            Team[]
  warehouses       Warehouse[]
  productionUnits  ProductionUnit[]
  vehicles         Vehicle[]
  drivers          Driver[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]
  invoices         Invoice[]
  inboundReceipts  InboundReceipt[]
  outboundOrders   OutboundOrder[]
  productionOrders ProductionOrder[]
  trips            Trip[]
  returnOrders     ReturnOrder[]
}

/// Configurable role. `permissions` maps a module key (see src/lib/permissions.ts)
/// to "none" | "view" | "edit". Roles with fullAccess bypass the map.
model AccessRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  fullAccess  Boolean  @default(false)
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// When set, the user only sees data for this branch. Null = all branches.
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive     Boolean    @default(true)
  /// Domestic B2B: which Fresh PO section this person fills in (null = can act as any team).
  opsTeam      OpsTeam?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  teamMemberships TeamMember[]
  feedback        Feedback[]
  ledTeams        Team[]           @relation("TeamLead")
  leads           Lead[]
  stockMovements  StockMovement[]
  activities      Activity[]
  pickingSessions PickingSession[]
  packingSessions PackingSession[]
}

enum TeamType {
  SALES
  PROCUREMENT
  WAREHOUSE
  PRODUCTION
  LOGISTICS
  ACCOUNTS
  OTHER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  type      TeamType
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      User?    @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  members TeamMember[]

  @@unique([branchId, name])
}

model TeamMember {
  teamId  String
  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([teamId, userId])
}

enum ContactRole {
  CUSTOMER
  SUPPLIER
  TRANSPORTER
  OTHER
}

/// Third-party contact: any external entity in the supply chain. One contact
/// can hold several roles (e.g. both customer and supplier).
model Contact {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  roles             ContactRole[]
  contactPerson     String?
  /// Named points of contact at this company (Domestic B2B POC pickers).
  pocNames          String[]
  /// Customer delivers to more than one address (shown in Domestic MIS).
  multipleAddresses Boolean       @default(false)
  email             String?
  phone             String?
  gstin             String?
  pan               String?
  billingAddress    String?
  shippingAddress   String?
  city              String?
  state             String?
  pincode           String?
  creditLimit       Decimal       @default(0) @db.Decimal(14, 2)
  paymentTermsDays  Int           @default(30)
  notes             String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  leads           Lead[]
  quotations      Quotation[]
  salesOrders     SalesOrder[]
  invoices        Invoice[]
  purchaseOrders  PurchaseOrder[]
  inboundReceipts InboundReceipt[]
  vehicles        Vehicle[]
  drivers         Driver[]
  eWayBills       EWayBill[]
  returnOrders    ReturnOrder[]
  shippingDocs    ShippingDocument[]

  @@index([name])
}

// ═══ Platform ═══════════════════════════════════════════════════════════════

/// Singleton row (id = 1) holding company-wide settings.
model CompanySettings {
  id        Int      @id @default(1)
  name      String   @default("My Company")
  legalName String?
  gstin     String?
  pan       String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  currency  String   @default("INR")
  updatedAt DateTime @updatedAt
}

/// Running counters used to generate document numbers such as SO-00001.
model DocumentSequence {
  key     String @id
  prefix  String
  next    Int    @default(1)
  padding Int    @default(5)
}

/// Lightweight audit trail shown on dashboards and record pages.
model Activity {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  message    String
  /// Field-level changes { field: [old, new] }, for record history.
  changes    Json?
  updatedAt  DateTime @default(now()) @updatedAt
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ═══ Order Management: leads, quotations, sales orders ══════════════════════

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  estimatedValue Decimal    @default(0) @db.Decimal(14, 2)
  notes          String?
  ownerId        String?
  owner          User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Contact?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id         String          @id @default(cuid())
  number     String          @unique
  customerId String
  customer   Contact         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status     QuotationStatus @default(DRAFT)
  issueDate  DateTime        @default(now())
  validUntil DateTime?
  subtotal   Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal   Decimal         @default(0) @db.Decimal(14, 2)
  total      Decimal         @default(0) @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  lines       QuotationLine[]
  salesOrders SalesOrder[]

  @@index([status])
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  description String?
  quantity    Decimal   @db.Decimal(14, 3)
  unitPrice   Decimal   @db.Decimal(14, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  taxRate     Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal   @default(0) @db.Decimal(14, 2)
  position    Int       @default(0)
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id           String           @id @default(cuid())
  number       String           @unique
  customerId   String
  customer     Contact          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationId  String?
  quotation    Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId  String
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status       SalesOrderStatus @default(DRAFT)
  orderDate    DateTime         @default(now())
  expectedDate DateTime?
  subtotal     Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal     Decimal          @default(0) @db.Decimal(14, 2)
  total        Decimal          @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lines            SalesOrderLine[]
  invoices         Invoice[]
  outboundOrders   OutboundOrder[]
  productionOrders ProductionOrder[]
  returnOrders     ReturnOrder[]

  @@index([status])
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  description  String?
  quantity     Decimal    @db.Decimal(14, 3)
  unitPrice    Decimal    @db.Decimal(14, 2)
  discountPct  Decimal    @default(0) @db.Decimal(5, 2)
  taxRate      Decimal    @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal    @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal    @default(0) @db.Decimal(14, 2)
  /// Quantity reserved against warehouse stock (see reserveStock in src/lib/stock.ts).
  reservedQty  Decimal    @default(0) @db.Decimal(14, 3)
  deliveredQty Decimal    @default(0) @db.Decimal(14, 3)
  position     Int        @default(0)

  outboundLines    OutboundLine[]
  productionOrders ProductionOrder[]
}

// ═══ Order Management: purchase orders ══════════════════════════════════════

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  number       String              @unique
  supplierId   String
  supplier     Contact             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  subtotal     Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal     Decimal             @default(0) @db.Decimal(14, 2)
  total        Decimal             @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines           PurchaseOrderLine[]
  inboundReceipts InboundReceipt[]

  @@index([status])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  description     String?
  quantity        Decimal       @db.Decimal(14, 3)
  unitPrice       Decimal       @db.Decimal(14, 2)
  discountPct     Decimal       @default(0) @db.Decimal(5, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  lineTotal       Decimal       @default(0) @db.Decimal(14, 2)
  /// Quantity physically received on inbound receipts (accepted + rejected).
  receivedQty     Decimal       @default(0) @db.Decimal(14, 3)
  position        Int           @default(0)

  inboundLines InboundLine[]
}

// ═══ Inventory: items ═══════════════════════════════════════════════════════

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

enum ProductType {
  GOODS
  SERVICE
}

enum ItemType {
  RAW_MATERIAL
  SEMI_FINISHED
  FINISHED_GOOD
  TRADING
  CONSUMABLE
  SERVICE
}

/// How demand for an item is fulfilled.
enum SupplyMode {
  BUY // procured from suppliers
  MTS // make to stock
  MTO // make to order
  ATO // assemble to order
}

model Product {
  id            String           @id @default(cuid())
  sku           String           @unique
  name          String
  description   String?
  type          ProductType      @default(GOODS)
  itemType      ItemType         @default(TRADING)
  supplyMode    SupplyMode       @default(BUY)
  unit          String           @default("pcs")
  hsnCode       String?
  casNo         String?
  /// Technical / Formulation / Intermediate / Other
  productClass  String?
  /// B2B / B2C
  funnel        String?
  /// Other names this material appears under on inward/outward sheets.
  aliases       String[]
  salePrice     Decimal          @default(0) @db.Decimal(14, 2)
  purchasePrice Decimal          @default(0) @db.Decimal(14, 2)
  taxRate       Decimal          @default(18) @db.Decimal(5, 2)
  reorderLevel  Decimal          @default(0) @db.Decimal(14, 3)
  /// Inbound receipts of this item need a quality check before stock is updated.
  qcRequired    Boolean          @default(false)
  weightKg      Decimal?         @db.Decimal(10, 3)
  isActive      Boolean          @default(true)
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  binStocks          BinStock[]
  quotationLines     QuotationLine[]
  salesOrderLines    SalesOrderLine[]
  invoiceLines       InvoiceLine[]
  purchaseOrderLines PurchaseOrderLine[]
  inboundLines       InboundLine[]
  outboundLines      OutboundLine[]
  handlingUnitItems  HandlingUnitItem[]
  boms               Bom[]
  bomComponentOf     BomLine[]
  productionOrders   ProductionOrder[]
  returnLines        ReturnLine[]

  @@index([name])
}

// ═══ Warehouse Management ═══════════════════════════════════════════════════

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bins             Bin[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]
  inboundReceipts  InboundReceipt[]
  outboundOrders   OutboundOrder[]
  pickingSessions  PickingSession[]
  productionOrders ProductionOrder[]
  returnOrders     ReturnOrder[]
}

/// Stock numbers per product per warehouse. Only changed through the helpers
/// in src/lib/stock.ts so they always match the StockMovement ledger.
///   quantity    = stock in hand
///   reservedQty = promised to confirmed sales orders / production orders
///   allocatedQty = picked into an open picking session (subset of reserved)
///   available   = quantity - reservedQty
model StockLevel {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity     Decimal   @default(0) @db.Decimal(14, 3)
  reservedQty  Decimal   @default(0) @db.Decimal(14, 3)
  allocatedQty Decimal   @default(0) @db.Decimal(14, 3)
  updatedAt    DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

enum StockMovementType {
  OPENING
  RECEIPT // accepted on an inbound receipt
  DELIVERY // dispatched on an outbound order
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION_IN // finished goods from a passed production batch
  PRODUCTION_OUT // components consumed by production
  RETURN_IN // customer return restocked
  SCRAP
}

/// Immutable stock ledger. Positive quantity = stock in, negative = stock out.
model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  unitCost      Decimal?          @db.Decimal(14, 2)
  /// Model name of the source document, e.g. "OutboundOrder", "InboundReceipt", "ProductionBatch".
  referenceType String?
  referenceId   String?
  reference     String?
  note          String?
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

/// Optional bin/location mapping inside a warehouse.
model Bin {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String // e.g. "A-01-03"
  zone        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  stocks        BinStock[]
  inboundLines  InboundLine[]
  outboundLines OutboundLine[]

  @@unique([warehouseId, code])
}

model BinStock {
  id        String   @id @default(cuid())
  binId     String
  bin       Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt

  @@unique([binId, productId])
}

enum InboundStatus {
  QC_PENDING
  COMPLETED
  CANCELLED
}

enum QcResult {
  PENDING
  PASSED
  PARTIAL
  FAILED
}

/// Goods receipt note (GRN). Stock is updated only for accepted quantity once QC is done.
model InboundReceipt {
  id              String         @id @default(cuid())
  number          String         @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Contact?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status          InboundStatus  @default(QC_PENDING)
  receivedAt      DateTime       @default(now())
  supplierInvoice String?
  vehicleNo       String?
  /// Random token encoded in the GRN's QR label once QC passes.
  qrToken         String         @unique @default(cuid())
  qcCompletedAt   DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines InboundLine[]

  @@index([status])
}

model InboundLine {
  id                  String             @id @default(cuid())
  receiptId           String
  receipt             InboundReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  receivedQty         Decimal            @db.Decimal(14, 3)
  acceptedQty         Decimal            @default(0) @db.Decimal(14, 3)
  rejectedQty         Decimal            @default(0) @db.Decimal(14, 3)
  unitCost            Decimal            @default(0) @db.Decimal(14, 2)
  qcResult            QcResult           @default(PENDING)
  qcNotes             String?
  binId               String?
  bin                 Bin?               @relation(fields: [binId], references: [id], onDelete: SetNull)
}

enum OutboundStatus {
  PENDING
  PICKING
  PICKED
  PACKING
  PACKED
  DISPATCHED
  CANCELLED
}

/// Fulfilment of (part of) a sales order: pick → pack → dispatch.
model OutboundOrder {
  id               String          @id @default(cuid())
  number           String          @unique
  salesOrderId     String
  salesOrder       SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId      String
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status           OutboundStatus  @default(PENDING)
  pickingSessionId String?
  pickingSession   PickingSession? @relation(fields: [pickingSessionId], references: [id], onDelete: SetNull)
  tripId           String?
  trip             Trip?           @relation(fields: [tripId], references: [id], onDelete: SetNull)
  pickedAt         DateTime?
  packedAt         DateTime?
  dispatchedAt     DateTime?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  lines           OutboundLine[]
  packingSessions PackingSession[]
  handlingUnits   HandlingUnit[]
  shippingDocs    ShippingDocument[]
  invoices        Invoice[]

  @@index([status])
}

model OutboundLine {
  id               String          @id @default(cuid())
  outboundId       String
  outbound         OutboundOrder   @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  salesOrderLineId String?
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Decimal         @db.Decimal(14, 3)
  pickedQty        Decimal         @default(0) @db.Decimal(14, 3)
  packedQty        Decimal         @default(0) @db.Decimal(14, 3)
  binId            String?
  bin              Bin?            @relation(fields: [binId], references: [id], onDelete: SetNull)
}

enum SessionStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Wave picking: one picker collects stock for several outbound orders.
model PickingSession {
  id           String        @id @default(cuid())
  number       String        @unique
  warehouseId  String
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  assignedToId String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  status       SessionStatus @default(OPEN)
  startedAt    DateTime      @default(now())
  completedAt  DateTime?

  outbounds OutboundOrder[]
}

model PackingSession {
  id          String        @id @default(cuid())
  number      String        @unique
  outboundId  String
  outbound    OutboundOrder @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  packedById  String?
  packedBy    User?         @relation(fields: [packedById], references: [id], onDelete: SetNull)
  status      SessionStatus @default(OPEN)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
}

enum HandlingUnitType {
  BOX
  CARTON
  PALLET
  CRATE
  BAG
}

/// A physical package (box, pallet…) on an outbound order, labelled with a QR code.
model HandlingUnit {
  id         String           @id @default(cuid())
  code       String           @unique
  outboundId String
  outbound   OutboundOrder    @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  type       HandlingUnitType @default(BOX)
  weightKg   Decimal?         @db.Decimal(10, 3)
  dimensions String? // e.g. "60x40x40 cm"
  qrToken    String           @unique @default(cuid())
  createdAt  DateTime         @default(now())

  items HandlingUnitItem[]
}

model HandlingUnitItem {
  id             String       @id @default(cuid())
  handlingUnitId String
  handlingUnit   HandlingUnit @relation(fields: [handlingUnitId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(14, 3)
}

// ═══ Manufacturing Ops ══════════════════════════════════════════════════════

/// Hub settings: a factory / production unit and its static information.
model ProductionUnit {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  address      String?
  shiftsPerDay Int      @default(1)
  shiftStart   String   @default("09:00") // HH:mm
  shiftHours   Decimal  @default(8) @db.Decimal(4, 2)
  /// ISO weekdays the unit works, 1 = Monday … 7 = Sunday.
  workingDays  Int[]    @default([1, 2, 3, 4, 5, 6])
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  machines Machine[]
}

enum MachineStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Machine {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  type             String?
  productionUnitId String
  productionUnit   ProductionUnit @relation(fields: [productionUnitId], references: [id], onDelete: Restrict)
  /// Available machine hours per working day (all shifts).
  hoursPerDay      Decimal        @default(8) @db.Decimal(5, 2)
  hourlyCost       Decimal        @default(0) @db.Decimal(14, 2)
  status           MachineStatus  @default(ACTIVE)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  operations    BomOperation[]
  scheduleSlots ProductionScheduleSlot[]
}

/// Bill of materials: components and operations needed to make `outputQty` of a product.
model Bom {
  id        String   @id @default(cuid())
  code      String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  version   Int      @default(1)
  isDefault Boolean  @default(true)
  outputQty Decimal  @default(1) @db.Decimal(14, 3)
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines            BomLine[]
  operations       BomOperation[]
  productionOrders ProductionOrder[]

  @@unique([productId, version])
}

model BomLine {
  id          String  @id @default(cuid())
  bomId       String
  bom         Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation(fields: [componentId], references: [id], onDelete: Restrict)
  quantity    Decimal @db.Decimal(14, 4) // per bom.outputQty
  scrapPct    Decimal @default(0) @db.Decimal(5, 2)
  position    Int     @default(0)
}

model BomOperation {
  id              String   @id @default(cuid())
  bomId           String
  bom             Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  sequence        Int
  name            String
  machineId       String?
  machine         Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  setupHours      Decimal  @default(0) @db.Decimal(8, 2)
  runHoursPerUnit Decimal  @default(0) @db.Decimal(10, 4)
}

enum ProductionOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id               String                @id @default(cuid())
  number           String                @unique
  productId        String
  product          Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  bomId            String
  bom              Bom                   @relation(fields: [bomId], references: [id], onDelete: Restrict)
  mode             SupplyMode            @default(MTS)
  quantity         Decimal               @db.Decimal(14, 3)
  producedQty      Decimal               @default(0) @db.Decimal(14, 3)
  salesOrderId     String?
  salesOrder       SalesOrder?           @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  salesOrderLineId String?
  salesOrderLine   SalesOrderLine?       @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  branchId         String
  branch           Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Components are consumed from, and finished goods put into, this warehouse.
  warehouseId      String
  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status           ProductionOrderStatus @default(DRAFT)
  priority         Int                   @default(3) // 1 = highest
  dueDate          DateTime?
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  batches       ProductionBatch[]
  scheduleSlots ProductionScheduleSlot[]

  @@index([status])
}

/// One block on the production calendar: an operation of an order on a machine.
model ProductionScheduleSlot {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  machineId         String
  machine           Machine         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  operationName     String
  start             DateTime
  end               DateTime

  @@index([machineId, start])
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  QC_PENDING
  PASSED
  PARTIALLY_PASSED
  FAILED
}

/// Production happens in batches; passing batch QC posts stock automatically.
model ProductionBatch {
  id                String          @id @default(cuid())
  number            String          @unique
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  quantity          Decimal         @db.Decimal(14, 3)
  passedQty         Decimal         @default(0) @db.Decimal(14, 3)
  failedQty         Decimal         @default(0) @db.Decimal(14, 3)
  status            BatchStatus     @default(PLANNED)
  startedAt         DateTime?
  completedAt       DateTime?
  qcAt              DateTime?
  qcNotes           String?
  qrToken           String          @unique @default(cuid())
  createdAt         DateTime        @default(now())
}

// ═══ Logistics ══════════════════════════════════════════════════════════════

enum VehicleOwnership {
  OWN
  THIRD_PARTY
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id             String           @id @default(cuid())
  registrationNo String           @unique
  type           String           @default("Truck") // Truck, Tempo, Van, Container…
  make           String?
  model          String?
  capacityKg     Decimal?         @db.Decimal(10, 2)
  ownership      VehicleOwnership @default(OWN)
  transporterId  String?
  transporter    Contact?         @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status         VehicleStatus    @default(AVAILABLE)
  operatingStart String?          @default("08:00") // HH:mm
  operatingEnd   String?          @default("20:00")
  insuranceUntil DateTime?
  fitnessUntil   DateTime?
  permitUntil    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignments DriverAssignment[]
  fuelLogs    FuelLog[]
  trips       Trip[]
  eWayBills   EWayBill[]
}

model Driver {
  id            String    @id @default(cuid())
  name          String
  phone         String?
  licenseNo     String?
  licenseUntil  DateTime?
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transporterId String?
  transporter   Contact?  @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments DriverAssignment[]
  fuelLogs    FuelLog[]
  trips       Trip[]
}

model DriverAssignment {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime?
  notes     String?
}

model FuelLog {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  date       DateTime @default(now())
  litres     Decimal  @db.Decimal(10, 2)
  amount     Decimal  @db.Decimal(14, 2)
  odometerKm Decimal? @db.Decimal(12, 1)
  station    String?
  notes      String?
  createdAt  DateTime @default(now())
}

enum TripStatus {
  PLANNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Trip {
  id            String     @id @default(cuid())
  number        String     @unique
  vehicleId     String
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId      String?
  driver        Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  origin        String
  destination   String
  status        TripStatus @default(PLANNED)
  plannedStart  DateTime?
  actualStart   DateTime?
  actualEnd     DateTime?
  startOdometer Decimal?   @db.Decimal(12, 1)
  endOdometer   Decimal?   @db.Decimal(12, 1)
  freightCost   Decimal    @default(0) @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  outbounds    OutboundOrder[]
  shippingDocs ShippingDocument[]

  @@index([status])
}

enum ShippingDocType {
  ASN // advance shipping notice sent to the customer at dispatch
  DN // delivery note signed by the customer on delivery
}

model ShippingDocument {
  id               String          @id @default(cuid())
  number           String          @unique
  type             ShippingDocType
  outboundId       String?
  outbound         OutboundOrder?  @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  tripId           String?
  trip             Trip?           @relation(fields: [tripId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Contact?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  issuedAt         DateTime        @default(now())
  expectedDelivery DateTime?
  deliveredAt      DateTime?
  receivedBy       String?
  notes            String?
}

// ═══ Books / Accounts ═══════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id            String         @id @default(cuid())
  number        String         @unique
  customerId    String
  customer      Contact        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrderId  String?
  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  outboundId    String?
  outbound      OutboundOrder? @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status        InvoiceStatus  @default(DRAFT)
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  placeOfSupply String?
  subtotal      Decimal        @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal        @default(0) @db.Decimal(14, 2)
  total         Decimal        @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal        @default(0) @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lines        InvoiceLine[]
  payments     Payment[]
  eWayBills    EWayBill[]
  returnOrders ReturnOrder[]

  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  description String?
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal @default(0) @db.Decimal(14, 2)
  position    Int     @default(0)
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime      @default(now())
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
}

enum EWayBillStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

/// E-way bill details recorded against an invoice (generated on the GST portal).
model EWayBill {
  id            String         @id @default(cuid())
  number        String         @unique // 12-digit EWB number
  invoiceId     String
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleNo     String?
  transporterId String?
  transporter   Contact?       @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  fromPlace     String
  toPlace       String
  distanceKm    Int
  generatedAt   DateTime       @default(now())
  validUntil    DateTime
  status        EWayBillStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime       @default(now())
}

// ═══ Return Management ══════════════════════════════════════════════════════

enum ReturnStatus {
  REQUESTED
  RECEIVED
  INSPECTED
  CLOSED
  CANCELLED
}

enum ReturnDisposition {
  PENDING
  REPAIR
  RESTOCK
  SCRAP
}

model ReturnOrder {
  id           String       @id @default(cuid())
  number       String       @unique
  customerId   String
  customer     Contact      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrderId String?
  salesOrder   SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  invoiceId    String?
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status       ReturnStatus @default(REQUESTED)
  reason       String?
  requestedAt  DateTime     @default(now())
  receivedAt   DateTime?
  inspectedAt  DateTime?
  closedAt     DateTime?
  creditAmount Decimal      @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lines ReturnLine[]

  @@index([status])
}

model ReturnLine {
  id           String            @id @default(cuid())
  returnId     String
  returnOrder  ReturnOrder       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Decimal           @db.Decimal(14, 3)
  receivedQty  Decimal           @default(0) @db.Decimal(14, 3)
  disposition  ReturnDisposition @default(PENDING)
  restockedQty Decimal           @default(0) @db.Decimal(14, 3)
  scrappedQty  Decimal           @default(0) @db.Decimal(14, 3)
  repairedAt   DateTime?
  qcNotes      String?
}

// ═══ Domestic B2B order management ══════════════════════════════════════════
// Ported from the Atomgrid Domestic B2B CRM. Customer / supplier / product /
// transporter names are stored as text exactly as entered or imported (the
// masters are pickers, and "not in master" is a warning, not an error); see
// src/lib/ops for shared helpers.

enum OpsTeam {
  DEMAND
  SUPPLY
  LOGISTICS
  SCM
}

/// Internal points of contact (people names) used across Fresh PO and Domestic MIS.
model OpsPoc {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

enum FreshPoBoard {
  FRESH
  LONG_HOLD
  MIS // moved to Domestic MIS
}

enum FreshPoStage {
  DEMAND_PENDING
  SUPPLY_PENDING
  LOGISTICS_PENDING
  READY
}

/// A customer purchase order working its way through Demand → Supply → Logistics.
model FreshPo {
  id        String       @id @default(cuid())
  /// Serial per board (Fresh PO and Long Hold each count 1, 2, 3…).
  requestNo Int?
  board     FreshPoBoard @default(FRESH)
  stage     FreshPoStage @default(DEMAND_PENDING)

  // Demand team
  customer             String?
  demandPoc            String?
  poDate               DateTime? @db.Date
  product              String?
  productType          String?
  poQty                Decimal?  @db.Decimal(14, 3)
  qtyToDispatch        Decimal?  @db.Decimal(14, 3)
  rate                 Decimal?  @db.Decimal(14, 2)
  totalTaxable         Decimal?  @db.Decimal(16, 2)
  paymentTerms         String?
  paymentReceived      String?
  customerType         String?
  customerPoc          String?
  scmContactCustomer   String?
  deliveryAddress      String?
  logisticsPaymentTerm String?
  cxLogisticsPoc       String?
  logisticsType        String?
  scmToDispatch        String?
  businessLeg          String?   @default("B2B")
  notes                String?

  // Supply team
  agSupplyPoc   String?
  supplier      String?
  supplyPoc     String?
  pickupAddress String?
  hsnCode       String?
  packaging     String?
  originType    String?
  batchNo       String?

  // Logistics team
  movementType String? @default("Forward")
  verifiedBy   String?

  /// Day the PO was brought back from Long Hold (restarts the 15-day clock).
  holdReleasedAt DateTime? @db.Date
  /// Domestic MIS job created from this PO.
  misJobId       String?   @unique
  misJob         MisJob?   @relation(fields: [misJobId], references: [id], onDelete: SetNull)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([board, deletedAt])
  @@index([stage])
}

enum MisStatus {
  FRESH_PO
  PLANNED
  MATERIAL_READY
  INTRANSIT
  DELIVERED
  ON_HOLD
  CANCELLED
}

/// Domestic MIS: the master shipment record, one row per job.
model MisJob {
  id     String     @id @default(cuid())
  /// Plain serial for new jobs; imported legacy numbers (e.g. "26-01-0671") are kept as text.
  jobNo  String
  status MisStatus?
  /// manual | fresh-po | import
  source String     @default("manual")

  // Identification
  poDate      DateTime? @db.Date
  supplier    String?
  customer    String?
  productName String?

  // Product & quantity
  quantityKgs Decimal? @db.Decimal(14, 3)
  batchNo     String?
  grossWtKg   Decimal? @db.Decimal(14, 3)
  packing     String?
  unitCount   String?
  hsCode      String?

  // Schedule
  plannedEtd          DateTime? @db.Date
  plannedEta          DateTime? @db.Date
  cxQuoteApprovalTime DateTime?
  sxReadinessTime     DateTime?
  actualEtd           DateTime? @db.Date
  actualEta           DateTime? @db.Date

  // POCs
  logisticsPoc       String?
  agSupplyPoc        String?
  agDemandPoc        String?
  supplyPoc          String?
  customerPocDetails String?

  // Addresses
  pickupAddress String?
  pickupPincode String?
  dropAddress   String?
  dropPincode   String?

  // Logistics
  logisticsType        String?
  vehicleType          String?
  transporterDetails   String?
  totalLogisticsCost   Decimal? @db.Decimal(14, 2)
  logisticsCostAgToPay Decimal? @db.Decimal(14, 2)
  logisticsPaymentTerm String?
  originType           String?
  destinationType      String?
  distanceApprox       Decimal? @db.Decimal(10, 1)
  movementType         String?

  // Commercials & tax
  taxableValue    Decimal?  @db.Decimal(16, 2)
  /// YYYY-MM
  taxInvoiceMonth String?
  taxInvoicedDate DateTime? @db.Date

  // Transport payment
  transportPaymentStatus String?
  transportPaidSoFar     Decimal?  @db.Decimal(14, 2)
  transportPaidOn        DateTime? @db.Date
  transportPaymentRef    String?

  // Tracking
  blockersRemarks     String?
  planningActionables String?
  cxSxAlignmentTime   String?
  statusConfirmedDate String?

  freshPo   FreshPo?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobNo])
  @@index([deletedAt, status])
}

/// A document attached to a Domestic B2B record (PO, COA, POD, e-way bill, screenshot…).
/// Polymorphic: entityType is "FreshPo" | "MisJob" | "Feedback" | …; field names the slot.
model OpsFile {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  /// FreshPo: PO | PI | COA | MSDS | OTHER. MisJob: taxInvoice | eWayBill | coa | transportDoc | pod.
  field        String
  fileName     String
  contentType  String?
  size         Int?
  /// Key in file storage (src/lib/storage.ts); null for an external link.
  storageKey   String?
  url          String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

/// D-0 quotation board: transporter quotes and vehicle progress for a job dispatching that day.
model DispatchQuote {
  id                  String   @id @default(cuid())
  jobNo               String
  plannedFor          DateTime @db.Date
  /// planned-today | manual
  source              String   @default("planned-today")
  customer            String?
  supplier            String?
  distance            String?
  pickupAddress       String?
  deliveryAddress     String?
  netWeight           String?
  grossWt             String?
  packing             String?
  taxableValue        String?
  paymentTerms        String?
  agDemandPoc         String?
  materialReadiness   String?
  materialReadyTime   String?
  /// Last completed step of the vehicle stepper.
  vehicleStatus       String?
  vehicleStages       String[]
  vehicleArrangements String?
  vehicleDetails      String?
  vehicleType         String?
  /// "Tx1".."Tx4"
  approvedTx          String?
  /// Four transporter quotes: [{ name, quote, tat, remarks }]
  bids                Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([jobNo, plannedFor])
}

/// Batch-level inward register (one row per batch received at an AG warehouse).
model BatchInward {
  id              String    @id @default(cuid())
  jobNo           String?
  inwardDate      DateTime? @db.Date
  location        String
  funnel          String?
  supplyPoc       String?
  grnNo           String?
  manufacturer    String?
  supplier        String?
  productName     String
  /// AG Catalogue Name: the material stock is kept under.
  catalogueName   String?
  type            String?
  hsn             String?
  batchNo         String?
  units           Decimal?  @db.Decimal(14, 3)
  packaging       String?
  uom             String?
  netWeight       Decimal   @db.Decimal(14, 3)
  grossWeight     Decimal?  @db.Decimal(14, 3)
  mfgDate         DateTime? @db.Date
  expDate         DateTime? @db.Date
  purchaseRate    Decimal?  @db.Decimal(14, 2)
  remarks         String?
  /// Outward Qty recorded on the imported sheet (CRM-entered outward is added on top).
  sheetOutwardQty Decimal?  @db.Decimal(14, 3)
  license         String?
  /// Dedup key for imports: jobNo|grnNo|batchNo|productName|netWeight|inwardDate
  lineKey         String
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([deletedAt])
  @@index([batchNo])
  @@index([lineKey])
}

/// Batch-level outward register. Only source "crm" lines reduce stock; "sheet" lines
/// are already counted in the inward sheet's Outward Qty.
model BatchOutward {
  id            String    @id @default(cuid())
  /// sheet | crm
  source        String    @default("crm")
  jobNo         String?
  obDate        DateTime? @db.Date
  warehouse     String?
  funnel        String?
  customer      String?
  grnNo         String?
  productName   String
  catalogueName String?
  batchNo       String?
  qty           Decimal   @db.Decimal(14, 3)
  saleRate      Decimal?  @db.Decimal(14, 2)
  /// Dedup key for imports: jobNo|obDate|customer|batchNo|qty|grnNo
  outKey        String
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deletedAt])
  @@index([batchNo])
  @@index([outKey])
}

enum InventoryIssueKind {
  LOST_FOUND
  DAMAGE
}

/// Lost & Found and Damage & Relabelling registers (they do not move stock).
model InventoryIssue {
  id          String             @id @default(cuid())
  kind        InventoryIssueKind
  date        DateTime?          @db.Date
  status      String?
  jobNo       String?
  productName String?
  batchNo     String?
  qtyKg       Decimal?           @db.Decimal(14, 3)
  /// Remaining register fields (see the register definitions in the app).
  data        Json               @default("{}")
  entryKey    String?
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([kind, deletedAt])
}

/// Last uploaded warehouse stock count (e.g. the warehouse MIS "Stock in Hand" tab).
model WarehouseCount {
  id         String    @id @default(cuid())
  /// warehouse-mis
  kind       String    @unique
  fileName   String
  countDate  DateTime? @db.Date
  /// [{ name, batch, received, dispatched, closing }]
  rows       Json
  uploadedAt DateTime  @default(now())
}

enum FeedbackKind {
  BUG
  FEATURE
}

/// "Report a bug" / "Feature request" from the top bar.
model Feedback {
  id        String       @id @default(cuid())
  kind      FeedbackKind
  title     String
  details   String?
  page      String?
  /// Blocking my work | Annoying | Minor (bugs)
  priority  String?
  /// New | In progress | Done | Won't do
  status    String       @default("New")
  reply     String?
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
