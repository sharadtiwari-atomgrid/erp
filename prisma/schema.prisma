generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Platform ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  SALES
  PURCHASE
  WAREHOUSE
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads          Lead[]
  stockMovements StockMovement[]
  activities     Activity[]
}

/// Singleton row (id = 1) holding company-wide settings.
model CompanySettings {
  id        Int      @id @default(1)
  name      String   @default("My Company")
  legalName String?
  gstin     String?
  pan       String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  currency  String   @default("INR")
  updatedAt DateTime @updatedAt
}

/// Running counters used to generate document numbers such as SO-00001.
model DocumentSequence {
  key     String @id // e.g. "CUSTOMER", "QUOTATION", "SALES_ORDER"
  prefix  String
  next    Int    @default(1)
  padding Int    @default(5)
}

/// Lightweight audit trail shown on dashboards and record pages.
model Activity {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String // e.g. "SalesOrder"
  entityId   String
  action     String // e.g. "created", "confirmed"
  message    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Customer {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  email            String?
  phone            String?
  gstin            String?
  billingAddress   String?
  shippingAddress  String?
  city             String?
  state            String?
  pincode          String?
  creditLimit      Decimal  @default(0) @db.Decimal(14, 2)
  paymentTermsDays Int      @default(30)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leads       Lead[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@index([name])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  source         String? // e.g. "Website", "Referral"
  status         LeadStatus @default(NEW)
  estimatedValue Decimal    @default(0) @db.Decimal(14, 2)
  notes          String?
  ownerId        String?
  owner          User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

enum ProductType {
  GOODS
  SERVICE
}

model Product {
  id            String           @id @default(cuid())
  sku           String           @unique
  name          String
  description   String?
  type          ProductType      @default(GOODS)
  unit          String           @default("pcs")
  hsnCode       String?
  salePrice     Decimal          @default(0) @db.Decimal(14, 2)
  purchasePrice Decimal          @default(0) @db.Decimal(14, 2)
  taxRate       Decimal          @default(18) @db.Decimal(5, 2) // GST %
  reorderLevel  Decimal          @default(0) @db.Decimal(14, 3)
  isActive      Boolean          @default(true)
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  quotationLines     QuotationLine[]
  salesOrderLines    SalesOrderLine[]
  invoiceLines       InvoiceLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([name])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
}

/// Current on-hand quantity per product per warehouse. Only changed through
/// `adjustStock()` in src/lib/stock.ts so it always matches StockMovement.
model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

enum StockMovementType {
  RECEIPT // goods received against a purchase order
  DELIVERY // goods delivered against a sales order
  ADJUSTMENT // manual correction (positive or negative)
  TRANSFER_IN
  TRANSFER_OUT
  OPENING // opening balance
}

/// Immutable stock ledger. Positive quantity = stock in, negative = stock out.
model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  unitCost      Decimal?          @db.Decimal(14, 2)
  referenceType String? // e.g. "SalesOrder", "PurchaseOrder"
  referenceId   String?
  reference     String? // human-readable document number
  note          String?
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

// ─── Purchasing ──────────────────────────────────────────────────────────────

model Supplier {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  email            String?
  phone            String?
  gstin            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  paymentTermsDays Int      @default(30)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([name])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  number       String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  subtotal     Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal     Decimal             @default(0) @db.Decimal(14, 2)
  total        Decimal             @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines PurchaseOrderLine[]

  @@index([status])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  description     String?
  quantity        Decimal       @db.Decimal(14, 3)
  unitPrice       Decimal       @db.Decimal(14, 2)
  discountPct     Decimal       @default(0) @db.Decimal(5, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  lineTotal       Decimal       @default(0) @db.Decimal(14, 2) // after discount, before tax
  receivedQty     Decimal       @default(0) @db.Decimal(14, 3)
  position        Int           @default(0)
}

// ─── Sales ───────────────────────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id         String          @id @default(cuid())
  number     String          @unique
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status     QuotationStatus @default(DRAFT)
  issueDate  DateTime        @default(now())
  validUntil DateTime?
  subtotal   Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal   Decimal         @default(0) @db.Decimal(14, 2)
  total      Decimal         @default(0) @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  lines       QuotationLine[]
  salesOrders SalesOrder[]

  @@index([status])
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  description String?
  quantity    Decimal   @db.Decimal(14, 3)
  unitPrice   Decimal   @db.Decimal(14, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  taxRate     Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal   @default(0) @db.Decimal(14, 2)
  position    Int       @default(0)
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id           String           @id @default(cuid())
  number       String           @unique
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationId  String?
  quotation    Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  warehouseId  String
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status       SalesOrderStatus @default(DRAFT)
  orderDate    DateTime         @default(now())
  expectedDate DateTime?
  subtotal     Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal     Decimal          @default(0) @db.Decimal(14, 2)
  total        Decimal          @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lines    SalesOrderLine[]
  invoices Invoice[]

  @@index([status])
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  description  String?
  quantity     Decimal    @db.Decimal(14, 3)
  unitPrice    Decimal    @db.Decimal(14, 2)
  discountPct  Decimal    @default(0) @db.Decimal(5, 2)
  taxRate      Decimal    @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal    @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal    @default(0) @db.Decimal(14, 2)
  deliveredQty Decimal    @default(0) @db.Decimal(14, 3)
  position     Int        @default(0)
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrderId  String?
  salesOrder    SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  placeOfSupply String? // state name; compared with company state for CGST/SGST vs IGST
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  description String?
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal @default(0) @db.Decimal(14, 2)
  position    Int     @default(0)
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime      @default(now())
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
}
