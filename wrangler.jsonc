{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed to the "erp" Worker on Cloudflare via OpenNext (npm run cf:deploy).
  "main": ".open-next/worker.js",
  "name": "erp",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding used by OpenNext; must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "erp"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put <NAME>`): DATABASE_URL, SESSION_SECRET.
  // Optional document storage on R2 via its S3 API: BUCKET_ENDPOINT, BUCKET_REGION,
  // BUCKET_ACCESS_KEY_ID, BUCKET_SECRET_ACCESS_KEY, BUCKET_NAME.
}
